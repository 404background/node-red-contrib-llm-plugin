{
  "name": "@background404/node-red-contrib-llm-plugin",
  "version": "0.6.0",
  "description": "Node-RED sidebar plugin for chatting with LLMs (Ollama / OpenAI / Custom OpenAI-compatible endpoints), generating flows, and importing results",
  "main": "llm_plugin.js",
  "files": [
    "llm_plugin.js",
    "llm_plugin.html",
    "llm-plugin_styles.css",
    "src/",
    "images/"
  ],
  "scripts": {
    "test": "node test/run_all.js",
    "test:llm": "node test/llm_roundtrip.test.js && node test/llm_scenarios.test.js"
  },
  "node-red": {
    "version": ">=4.0.0",
    "plugins": {
      "llm_plugin": "llm_plugin.js"
    }
  },
  "keywords": [
    "node-red",
    "plugin",
    "editor",
    "llm-plugin",
    "llm",
    "ollama",
    "ai"
  ],
  "author": "background404",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "fs-extra": "^11.4.0",
    "marked": "^18.0.13",
    "openai": "^7.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/404background/node-red-contrib-llm-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/404background/node-red-contrib-llm-plugin/issues"
  },
  "homepage": "https://github.com/404background/node-red-contrib-llm-plugin#readme"
}
